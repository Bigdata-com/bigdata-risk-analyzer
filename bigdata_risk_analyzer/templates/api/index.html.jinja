{% extends "/api/base.html.jinja" %}
{% block content %}

<div id="infoModalsContainer"></div>

<!-- Screener Guide Modal -->
<div id="screenerGuideModal" class="hidden fixed inset-0 bg-black/70 backdrop-blur-sm z-50 flex items-center justify-center p-4">
  <div class="bg-zinc-900 border border-zinc-700 rounded-xl max-w-4xl w-full max-h-[90vh] overflow-y-auto">
    <div class="p-6">
      <!-- Modal Header -->
      <div class="flex items-center justify-between mb-6">
        <h2 class="text-2xl font-bold text-white">How to Use the Company Screener</h2>
        <button onclick="hideScreenerGuide()" class="text-zinc-400 hover:text-white transition-colors">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>
      
      <!-- Guide Content -->
      <div class="space-y-6">
        <!-- Multi-Select Filters -->
        <div class="bg-blue-500/10 border border-blue-500/30 rounded-lg p-4">
          <h3 class="text-lg font-semibold text-blue-400 mb-2">Multi-Select Filters</h3>
          <p class="text-zinc-300 text-sm mb-2">
            <strong>Hold Ctrl/Cmd and click</strong> to select multiple options in Sector, Industry, and Risk filters.
          </p>
          <ul class="text-zinc-400 text-xs space-y-1">
            <li>• <strong>Sector Filter:</strong> Select multiple sectors to focus on specific industries</li>
            <li>• <strong>Industry Filter:</strong> Choose multiple industries within selected sectors</li>
            <li>• <strong>Risk Filter:</strong> Select specific risk factors to analyze exposure</li>
            <li>• <strong>Filter Counts:</strong> Colored badges show how many options are selected</li>
          </ul>
        </div>
        
        
        <!-- Table Features -->
        <div class="bg-green-500/10 border border-green-500/30 rounded-lg p-4">
          <h3 class="text-lg font-semibold text-green-400 mb-2">Table Features</h3>
          <ul class="text-zinc-300 text-sm space-y-1">
            <li>• <strong>Sortable Columns:</strong> Click headers to sort by any metric</li>
            <li>• <strong>Top Risks:</strong> Shows top 3 risk factors for each company</li>
            <li>• <strong>Insights:</strong> AI-generated risk exposure summary</li>
            <li>• <strong>Export:</strong> Download filtered results as CSV or JSON</li>
          </ul>
        </div>
        
        <!-- Workflow Examples -->
        <div class="bg-zinc-800/50 border border-zinc-600 rounded-lg p-4">
          <h3 class="text-lg font-semibold text-white mb-2">Common Workflows</h3>
          <div class="space-y-3">
            <div>
              <h4 class="text-sm font-semibold text-zinc-200 mb-1">1. Sector Analysis</h4>
              <p class="text-zinc-400 text-xs">Select "Technology" sector → Choose specific industries → Filter by "AI Risk" → Export results</p>
            </div>
            <div>
              <h4 class="text-sm font-semibold text-zinc-200 mb-1">2. Risk-Focused Analysis</h4>
              <p class="text-zinc-400 text-xs">Select multiple risk factors → Sort by Coverage Score → Identify most exposed companies</p>
            </div>
            <div>
              <h4 class="text-sm font-semibold text-zinc-200 mb-1">3. Portfolio Screening</h4>
              <p class="text-zinc-400 text-xs">Set Top N limit → Apply filters → Export for portfolio construction</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Heatmap Guide Modal -->
<div id="heatmapGuideModal" class="hidden fixed inset-0 bg-black/70 backdrop-blur-sm z-50 flex items-center justify-center p-4">
  <div class="bg-zinc-900 border border-zinc-700 rounded-xl max-w-4xl w-full max-h-[90vh] overflow-y-auto">
    <div class="p-6">
      <!-- Modal Header -->
      <div class="flex items-center justify-between mb-6">
        <h2 class="text-2xl font-bold text-white">How to Read This Heatmap</h2>
        <button onclick="hideHeatmapGuide()" class="text-zinc-400 hover:text-white transition-colors">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>
      
      <!-- Score Explanations -->
      <div class="space-y-6">
        <!-- Coverage Score -->
        <div class="bg-blue-500/10 border border-blue-500/30 rounded-lg p-4">
          <h3 class="text-lg font-semibold text-blue-400 mb-2">Coverage Score</h3>
          <p class="text-zinc-300 text-sm mb-2">
            <strong>Breadth of risk exposure.</strong> Shows what percentage of risk types affect this company.
          </p>
          <p class="text-zinc-400 text-xs">
            Formula: (Number of risks with evidence) ÷ (Total number of risks) × 100%
          </p>
          <p class="text-zinc-400 text-xs mt-1">
            Example: If a company is exposed to 3 out of 10 risk types, Coverage Score = 30%
          </p>
        </div>
        
        <!-- Intensity Score -->
        <div class="bg-purple-500/10 border border-purple-500/30 rounded-lg p-4">
          <h3 class="text-lg font-semibold text-purple-400 mb-2">Intensity Score</h3>
          <p class="text-zinc-300 text-sm mb-2">
            <strong>Depth of risk exposure.</strong> Shows how much evidence exists relative to the maximum for each risk.
          </p>
          <p class="text-zinc-400 text-xs">
            Formula: Average of (Company's evidence for each risk) ÷ (Maximum evidence for that risk across all companies)
          </p>
          <p class="text-zinc-400 text-xs mt-1">
            Example: If a company has 50% of the maximum evidence for each risk on average, Intensity Score = 50%
          </p>
        </div>
        
        <!-- Raw Score -->
        <div class="bg-red-500/10 border border-red-500/30 rounded-lg p-4">
          <h3 class="text-lg font-semibold text-red-400 mb-2">Raw Score</h3>
          <p class="text-zinc-300 text-sm mb-2">
            <strong>Total evidence sum.</strong> The original composite score before normalization.
          </p>
          <p class="text-zinc-400 text-xs">
            Formula: Sum of all evidence scores across all risk types for this company
          </p>
          <p class="text-zinc-400 text-xs mt-1">
            Example: If a company has evidence scores of [5, 3, 2] for 3 risks, Raw Score = 10
          </p>
        </div>
        
        <!-- Risk-Based Scoring (for future implementation) -->
        <div class="bg-green-500/10 border border-green-500/30 rounded-lg p-4">
          <h3 class="text-lg font-semibold text-green-400 mb-2">Risk-Based Scoring</h3>
          <p class="text-zinc-300 text-sm mb-2">
            <strong>When viewing by risks:</strong> Coverage and Intensity scores show how risks affect companies.
          </p>
          <p class="text-zinc-400 text-xs">
            • <strong>Risk Coverage:</strong> Percentage of companies exposed to this risk<br>
            • <strong>Risk Intensity:</strong> Average normalized evidence per company for this risk
          </p>
        </div>
        
        <!-- Interactive Features -->
        <div class="bg-zinc-800/50 border border-zinc-600 rounded-lg p-4">
          <h3 class="text-lg font-semibold text-white mb-2">Interactive Features</h3>
          <ul class="text-zinc-300 text-sm space-y-1">
            <li>• <strong>Click column headers</strong> to sort by Coverage, Intensity, or Raw Score</li>
            <li>• <strong>Click heatmap cells</strong> to filter evidence by company and risk</li>
            <li>• <strong>Hover over cells</strong> to see detailed scores</li>
            <li>• <strong>Toggle view</strong> between company-focused and risk-focused analysis</li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Header with Config Button -->
<header class="flex items-center justify-between mb-8 pb-4 border-b border-zinc-700">
  <div class="flex items-center gap-4">
    <svg class="w-10 h-10 text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-1.964-1.333-2.732 0L3.082 16c-.77 1.333.192 3 1.732 3z"></path>
    </svg>
    <div>
      <h1 class="text-3xl font-bold text-white">Risk Analyzer</h1>
      <p class="text-zinc-400 text-sm">AI-powered risk analysis for investment research</p>
    </div>
  </div>
  <div class="flex items-center gap-3">
    <button onclick="toggleConfigPanel()" 
      class="flex items-center gap-2 px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg font-medium transition-colors shadow-lg">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path>
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
      </svg>
      New Analysis
    </button>
    <button id="showJsonBtn" style="display:none;"
      class="px-6 py-2 bg-zinc-700 hover:bg-zinc-600 text-white rounded-lg font-medium transition-colors shadow-lg">
      JSON
    </button>
    <button id="newAnalysisBtn" onclick="resetToStart()" style="display:none;"
      class="flex items-center justify-center p-2 bg-zinc-700 hover:bg-zinc-600 text-white rounded-lg transition-colors shadow-lg"
      title="Start New Analysis">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
      </svg>
    </button>
  </div>
</header>

<!-- Empty State (shown when no analysis has been run) -->
<div id="emptyState" class="py-16 text-center">
  <div class="mb-8">
    <h2 class="text-3xl font-bold text-white mb-4">Ready to monitor risk exposure?</h2>
    <p class="text-zinc-300 text-lg max-w-2xl mx-auto">
      Select a pre-computed case to review existing analyses, or run a new one to uncover hidden vulnerabilities across your portfolio using AI-powered intelligence.
    </p>
  </div>
  
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-5xl mx-auto mb-8">
    <!-- Quick Start Card 1 -->
    <div onclick="loadQuickStartTemplate('import-tariffs')" 
      class="bg-gradient-to-br from-red-900/30 to-red-800/20 rounded-xl border border-red-700/40 p-8 cursor-pointer hover:shadow-xl hover:border-red-500/60 transition-all group">
      <div class="w-16 h-16 bg-red-500/20 rounded-lg flex items-center justify-center mx-auto mb-4 group-hover:scale-110 transition-transform">
        <svg class="w-8 h-8 text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
        </svg>
      </div>
      <h3 class="text-xl font-bold text-white mb-2">Import Tariffs against China</h3>
      <p class="text-zinc-400 text-sm">Supply chain risks, trade barriers, disruptions</p>
      <p class="text-red-400 text-xs mt-3">US Top 100</p>
    </div>
    
    <!-- Quick Start Card 2 -->
    <div onclick="loadQuickStartTemplate('energy-cost')" 
      class="bg-gradient-to-br from-orange-900/30 to-orange-800/20 rounded-xl border border-orange-700/40 p-8 cursor-pointer hover:shadow-xl hover:border-orange-500/60 transition-all group">
      <div class="w-16 h-16 bg-orange-500/20 rounded-lg flex items-center justify-center mx-auto mb-4 group-hover:scale-110 transition-transform">
        <svg class="w-8 h-8 text-orange-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
        </svg>
      </div>
      <h3 class="text-xl font-bold text-white mb-2">Rising Energy Costs</h3>
      <p class="text-zinc-400 text-sm">Operating expenses, production costs, profit margins</p>
      <p class="text-orange-400 text-xs mt-3">US Top 100</p>
    </div>
    
    <!-- Quick Start Card 3 -->
    <div onclick="loadQuickStartTemplate('operational-technology')" 
      class="bg-gradient-to-br from-yellow-900/30 to-yellow-800/20 rounded-xl border border-yellow-700/40 p-8 cursor-pointer hover:shadow-xl hover:border-yellow-500/60 transition-all group">
      <div class="w-16 h-16 bg-yellow-500/20 rounded-lg flex items-center justify-center mx-auto mb-4 group-hover:scale-110 transition-transform">
        <svg class="w-8 h-8 text-yellow-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
        </svg>
      </div>
      <h3 class="text-xl font-bold text-white mb-2">Operational & Technology</h3>
      <p class="text-zinc-400 text-sm">Cybersecurity, AI disruption, cloud dependency, labor</p>
      <p class="text-yellow-400 text-xs mt-3">US Top 100</p>
    </div>
  </div>
  
  <div class="flex items-center justify-center gap-4">
    <button onclick="toggleConfigPanel()" 
      class="flex items-center gap-2 px-6 py-3 bg-zinc-700 hover:bg-zinc-600 text-white rounded-lg font-medium transition-colors">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"></path>
      </svg>
      {% if demo_mode %}View Configuration{% else %}New Analysis{% endif %}
    </button>
  </div>
</div>

<!-- Dashboard Section (shown after analysis) -->
<div id="dashboardSection" class="hidden">
  <div id="resultsContainer" class="-mt-8">
    <!-- Configuration Header -->
    <div id="configurationHeader" class="bg-zinc-800/50 border-b border-zinc-700 px-6 py-4 sticky top-0 z-40 -mt-4">
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-6">
          <div class="flex items-center gap-3">
            <svg class="w-5 h-5 text-zinc-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            <span class="text-base font-semibold text-zinc-200">Risk Scenario:</span>
            <span class="text-lg font-bold text-white" id="currentRiskScenario">-</span>
          </div>
          <div class="w-px h-6 bg-zinc-500/60"></div>
          <div class="flex items-center gap-3">
            <svg class="w-5 h-5 text-zinc-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
            </svg>
            <span class="text-base font-semibold text-zinc-200">Universe:</span>
            <span class="text-lg font-bold text-white" id="currentUniverse">-</span>
          </div>
        </div>
        <div id="demoModeBadge" class="hidden">
          <div class="flex items-center gap-1 px-2 py-1 bg-amber-500/20 border border-amber-500/30 rounded text-xs">
            <svg class="w-3 h-3 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-1.964-1.333-2.732 0L3.082 16c-.77 1.333.192 3 1.732 3z"></path>
            </svg>
            <span class="text-amber-400 font-medium">Demo</span>
          </div>
        </div>
      </div>
    </div>
    
    <!-- Tab Navigation -->
    <div class="bg-zinc-800/50 border-b border-zinc-700 sticky top-16 z-30">
      <div class="flex gap-1 p-2">
        <button data-tab="overview" 
          class="flex items-center gap-2 px-4 py-3 rounded-lg font-medium text-sm transition-all duration-200 border-b-2 border-blue-500 text-blue-400 bg-blue-500/10">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 5a1 1 0 011-1h4a1 1 0 011 1v7a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM14 5a1 1 0 011-1h4a1 1 0 011 1v7a1 1 0 01-1 1h-4a1 1 0 01-1-1V5zM4 16a1 1 0 011-1h4a1 1 0 011 1v3a1 1 0 01-1 1H5a1 1 0 01-1-1v-3zM14 16a1 1 0 011-1h4a1 1 0 011 1v3a1 1 0 01-1 1h-4a1 1 0 01-1-1v-3z"></path>
          </svg>
          Overview
        </button>
        <button data-tab="summary" 
          class="flex items-center gap-2 px-4 py-3 rounded-lg font-medium text-sm transition-all duration-200 border-b-2 border-transparent text-zinc-400 hover:text-zinc-200">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 5a1 1 0 011-1h4a1 1 0 011 1v7a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM14 5a1 1 0 011-1h4a1 1 0 011 1v7a1 1 0 01-1 1h-4a1 1 0 01-1-1V5zM4 16a1 1 0 011-1h4a1 1 0 011 1v3a1 1 0 01-1 1H5a1 1 0 01-1-1v-3zM14 16a1 1 0 011-1h4a1 1 0 011 1v3a1 1 0 01-1 1h-4a1 1 0 01-1-1v-3z"></path>
          </svg>
          Risk Heatmap
        </button>
        <button data-tab="screener" 
          class="flex items-center gap-2 px-4 py-3 rounded-lg font-medium text-sm transition-all duration-200 border-b-2 border-transparent text-zinc-400 hover:text-zinc-200">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
          </svg>
          Company Screener
        </button>
        <button data-tab="mindmap" 
          class="flex items-center gap-2 px-4 py-3 rounded-lg font-medium text-sm transition-all duration-200 border-b-2 border-transparent text-zinc-400 hover:text-zinc-200">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"></path>
          </svg>
          Taxonomy
        </button>
        <button data-tab="evidence" 
          class="flex items-center gap-2 px-4 py-3 rounded-lg font-medium text-sm transition-all duration-200 border-b-2 border-transparent text-zinc-400 hover:text-zinc-200">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
          </svg>
          Evidence
        </button>
      </div>
    </div>

    <!-- Tab Contents -->
    <div class="bg-zinc-800/30 rounded-b-lg border border-zinc-700 border-t-0">
      <!-- Overview Tab -->
      <div data-tab-content="overview" class="p-6">
        <div class="loading-indicator hidden">
          <div class="flex items-center justify-center py-20">
            <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-red-500"></div>
            <span class="ml-3 text-zinc-400">Loading overview...</span>
          </div>
        </div>
        <div class="tab-actual-content"></div>
      </div>

      <!-- Summary Tab -->
      <div data-tab-content="summary" class="hidden p-6">
        <div class="loading-indicator hidden">
          <div class="flex items-center justify-center py-20">
            <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-red-500"></div>
            <span class="ml-3 text-zinc-400">Loading heatmap...</span>
          </div>
        </div>
        <div class="tab-actual-content"></div>
      </div>

      <!-- Companies Tab -->
      <div data-tab-content="screener" class="hidden p-6">
        <div class="loading-indicator hidden">
          <div class="flex items-center justify-center py-20">
            <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-red-500"></div>
            <span class="ml-3 text-zinc-400">Loading company screener...</span>
          </div>
        </div>
        <div class="tab-actual-content"></div>
      </div>

      <!-- Risk Taxonomy Tab -->
      <div data-tab-content="mindmap" class="hidden p-6">
        <div class="loading-indicator hidden">
          <div class="flex items-center justify-center py-20">
            <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-red-500"></div>
            <span class="ml-3 text-zinc-400">Loading taxonomy...</span>
          </div>
        </div>
        <div class="tab-actual-content"></div>
      </div>

      <!-- Evidence Tab -->
      <div data-tab-content="evidence" class="hidden p-6">
        <div class="loading-indicator hidden">
          <div class="flex items-center justify-center py-20">
            <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-red-500"></div>
            <span class="ml-3 text-zinc-400">Loading evidence...</span>
          </div>
        </div>
        <div class="tab-actual-content"></div>
      </div>
    </div>
  </div>
</div>

<!-- Configuration Panel (Slides in from right) -->
<div id="configBackdrop" class="hidden fixed inset-0 bg-black/70 backdrop-blur-sm z-40 transition-opacity duration-300"></div>
<div id="configPanel" class="fixed top-0 right-0 h-full w-full max-w-md bg-gradient-to-br from-zinc-800 to-zinc-900 shadow-2xl z-50 transform translate-x-full transition-transform duration-300 overflow-y-auto">
  <div class="p-6">
    <!-- Panel Header -->
    <div class="flex items-center justify-between mb-6 pb-4 border-b border-zinc-700">
      <h2 class="text-2xl font-bold text-white">Configuration</h2>
      <button onclick="closeConfigPanel()" class="text-zinc-400 hover:text-white transition-colors">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>
    
    <!-- Quick Start Templates -->
    <div class="mb-8">
      <h3 class="text-sm font-semibold text-zinc-400 mb-1 uppercase tracking-wide">Pre-computed Demos</h3>
      <p class="text-xs text-zinc-500 mb-3">Explore example risk analyses with pre-loaded results</p>
      <div class="space-y-2">
        <button onclick="loadQuickStartTemplate('import-tariffs')" 
          class="w-full text-left px-4 py-3 bg-red-600/20 hover:bg-red-600/30 border border-red-600/30 rounded-lg transition-colors">
          <div class="font-medium text-white">Import Tariffs against China</div>
          <div class="text-xs text-zinc-400">US Top 100</div>
        </button>
        <button onclick="loadQuickStartTemplate('energy-cost')" 
          class="w-full text-left px-4 py-3 bg-orange-600/20 hover:bg-orange-600/30 border border-orange-600/30 rounded-lg transition-colors">
          <div class="font-medium text-white">Rising Energy Costs</div>
          <div class="text-xs text-zinc-400">US Top 100</div>
        </button>
        <button onclick="loadQuickStartTemplate('operational-technology')" 
          class="w-full text-left px-4 py-3 bg-yellow-600/20 hover:bg-yellow-600/30 border border-yellow-600/30 rounded-lg transition-colors">
          <div class="font-medium text-white">Operational & Technology</div>
          <div class="text-xs text-zinc-400">US Top 100</div>
        </button>
      </div>
    </div>
    
    <!-- Custom Configuration Form -->
    <form id="riskForm" autocomplete="off">
      <h3 class="text-sm font-semibold text-zinc-400 mb-4 uppercase tracking-wide">Custom Configuration</h3>
      
      <!-- Theme -->
      <div class="mb-4">
        <label for="main_theme" class="block mb-2 font-medium text-sm text-white">
          <span>Risk Scenario</span>
          <button type="button" class="text-red-400 text-xs ml-1" onclick="showInfoModal('main_theme')" title="Info">ⓘ</button>
        </label>
        <input type="text" id="main_theme"
          class="bg-zinc-900 border border-zinc-600 text-white text-sm rounded-lg block w-full p-3 focus:ring-2 focus:ring-orange-500 focus:border-orange-500"
          placeholder="{{ main_theme }}" required value="{{ main_theme }}" />
      </div>

      <!-- Focus -->
      <div class="mb-4">
        <label for="focus" class="block mb-2 font-medium text-sm text-white">
          <span>Focus</span>
          <button type="button" class="text-red-400 text-xs ml-1" onclick="showInfoModal('focus')" title="Info">ⓘ</button>
        </label>
        <textarea id="focus"
          class="bg-zinc-900 border border-zinc-600 text-white text-sm rounded-lg block w-full p-3 focus:ring-2 focus:ring-blue-500 focus:border-red-500 min-h-[100px] resize-none"
          placeholder="{{ focus }}" required>{{ focus }}</textarea>
      </div>

      <!-- Company Universe -->
      <div class="mb-4">
        <label for="companies" class="block mb-2 font-medium text-sm text-white">
          <span>Company Universe</span>
          <button type="button" class="text-red-400 text-xs ml-1" onclick="showInfoModal('companies')" title="Info">ⓘ</button>
        </label>
        <div class="relative">
          <input id="companies_text" type="text"
            class="absolute w-[calc(100%-20px)] bg-zinc-900 text-white text-sm rounded-lg block p-3 h-[46px] focus:ring-2 focus:ring-blue-500 focus:border-red-500" />
          <select id="companies"
            class="bg-zinc-900 border border-zinc-600 text-white text-sm rounded-lg block w-full p-3 h-[46px] z-10 focus:ring-2 focus:ring-blue-500 focus:border-red-500 cursor-pointer"
            onchange="this.previousElementSibling.value=this.options[this.selectedIndex].text;">
          </select>
        </div>
      </div>

      <!-- Advanced Options Toggle -->
      <button type="button" onclick="toggleAdvancedOptions()" id="advancedOptionsBtn"
        class="w-full flex items-center justify-between px-4 py-3 bg-zinc-700 hover:bg-zinc-600 rounded-lg transition-colors mb-4">
        <span class="text-white font-medium text-sm">Advanced Options</span>
        <svg id="advancedOptionsIcon" class="w-4 h-4 text-white transform transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
        </svg>
      </button>

      <!-- Advanced Options -->
      <div id="advanced-options" class="hidden space-y-4 mb-6">
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label for="start_date" class="block mb-2 font-medium text-xs text-zinc-400">Start Date</label>
            <input type="date" id="start_date"
              class="bg-zinc-900 border border-zinc-600 text-white text-sm rounded-lg block w-full p-2 focus:ring-2 focus:ring-orange-500"
              value="{{ start_date }}" />
          </div>
          <div>
            <label for="end_date" class="block mb-2 font-medium text-xs text-zinc-400">End Date</label>
            <input type="date" id="end_date"
              class="bg-zinc-900 border border-zinc-600 text-white text-sm rounded-lg block w-full p-2 focus:ring-2 focus:ring-orange-500"
              value="{{ end_date }}" />
          </div>
        </div>
        
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label for="frequency" class="block mb-2 font-medium text-xs text-zinc-400">Frequency</label>
            <select id="frequency"
              class="bg-zinc-900 border border-zinc-600 text-white text-sm rounded-lg block w-full p-2 focus:ring-2 focus:ring-blue-500 cursor-pointer">
              <option value="D" {% if frequency=='D' %}selected{% endif %}>Daily</option>
              <option value="W" {% if frequency=='W' %}selected{% endif %}>Weekly</option>
              <option value="M" {% if frequency=='M' %}selected{% endif %}>Monthly</option>
              <option value="3M" {% if frequency=='3M' %}selected{% endif %}>Quarterly</option>
              <option value="Y" {% if frequency=='Y' %}selected{% endif %}>Yearly</option>
            </select>
          </div>
          <div>
            <label for="rerank_threshold" class="block mb-2 font-medium text-xs text-zinc-400">Rerank (0-1)</label>
            <input type="number" id="rerank_threshold"
              class="bg-zinc-900 border border-zinc-600 text-white text-sm rounded-lg block w-full p-2 focus:ring-2 focus:ring-orange-500"
              value="{{ rerank_threshold if rerank_threshold is defined and rerank_threshold is not none else '' }}"
              max="1" min="0" step="0.01">
          </div>
        </div>
        
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label for="document_limit" class="block mb-2 font-medium text-xs text-zinc-400">Doc Limit</label>
            <input type="number" id="document_limit"
              class="bg-zinc-900 border border-zinc-600 text-white text-sm rounded-lg block w-full p-2 focus:ring-2 focus:ring-orange-500"
              value="{{ document_limit }}" />
          </div>
          <div>
            <label for="batch_size" class="block mb-2 font-medium text-xs text-zinc-400">Batch Size</label>
            <input type="number" id="batch_size"
              class="bg-zinc-900 border border-zinc-600 text-white text-sm rounded-lg block w-full p-2 focus:ring-2 focus:ring-orange-500"
              value="{{ batch_size }}" />
          </div>
        </div>
        
        <!-- Hidden fields -->
        <input type="text" id="fiscal_year" class="hidden"
          value="{% if fiscal_year %}{% if fiscal_year is iterable and fiscal_year is not string %}{{ fiscal_year|join(', ') }}{% else %}{{ fiscal_year }}{% endif %}{% endif %}" />
        <input type="text" id="llm_model" class="hidden" value="{{ llm_model }}" />
        <select id="document_type" class="hidden">
          <option value="all" {% if document_type=='all' %}selected{% endif %}>ALL</option>
          <option value="filings" {% if document_type=='filings' %}selected{% endif %}>FILINGS</option>
          <option value="transcripts" {% if document_type=='transcripts' %}selected{% endif %}>TRANSCRIPTS</option>
          <option value="news" {% if document_type=='news' %}selected{% endif %}>NEWS</option>
          <option value="files" {% if document_type=='files' %}selected{% endif %}>FILES</option>
        </select>
      </div>

      <!-- Action Buttons -->
      <div class="space-y-3 pt-4 border-t border-zinc-700">
        {% if demo_mode %}
        <button type="button" disabled
          class="w-full flex items-center justify-center gap-2 text-zinc-500 bg-zinc-700 cursor-not-allowed font-bold rounded-lg text-base px-6 py-4 opacity-50">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
          </svg>
          Run Analysis (Disabled)
        </button>
        <p class="text-xs text-amber-400 text-center leading-relaxed">
          Demo mode activated. For access to the full version, please contact <a href="mailto:support@bigdata.com" class="underline hover:text-amber-300 transition-colors">support@bigdata.com</a> or deploy your own version from <a href="https://github.com/Bigdata-com/bigdata-thematic-screener" target="_blank" rel="noopener noreferrer" class="underline hover:text-amber-300 transition-colors">GitHub</a>.
        </p>
        {% else %}
        <button type="submit"
          class="w-full flex items-center justify-center gap-2 text-white bg-blue-600 hover:bg-blue-700 font-bold rounded-lg text-base px-6 py-4 transition-colors shadow-lg">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"></path>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          Run Analysis
        </button>
        {% endif %}
      </div>
    </form>
  </div>
</div>

<!-- Spinner -->
<div id="spinner" class="hidden fixed top-4 right-4 bg-zinc-800 border border-zinc-700 rounded-lg px-4 py-3 shadow-xl z-50">
  <div class="flex items-center gap-3">
    <div class="animate-spin rounded-full h-5 w-5 border-b-2 border-red-500"></div>
    <span class="text-white font-medium">Running analysis...</span>
  </div>
</div>

<!-- Logs below (Collapsible) -->
{% if not demo_mode %}
<div class="my-8 bg-gradient-to-br from-zinc-900 to-zinc-800 rounded-lg shadow-2xl border border-zinc-700">
  <button onclick="toggleProcessLogs()" 
    class="w-full flex items-center justify-between px-6 py-4 hover:bg-zinc-800/50 transition-colors rounded-t-lg">
    <h2 class="text-lg font-bold text-sky-400 flex items-center gap-2">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
          d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z">
        </path>
      </svg>
      Process Logs
    </h2>
    <svg id="logsIcon" class="w-5 h-5 text-zinc-400 transform transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
    </svg>
  </button>
  <div id="logViewerContainer" class="hidden px-6 pb-6">
    <div id="logViewer"
      class="bg-black/30 border border-slate-600 rounded-lg p-4 h-64 overflow-y-auto font-mono text-sm whitespace-pre-wrap break-words text-zinc-100 shadow-inner">
    </div>
  </div>
</div>
{% endif %}

<!-- Modal for JSON output -->
<div id="jsonModal" class="hidden fixed z-[1000] inset-0 w-screen h-screen bg-black/70 backdrop-blur-sm">
  <div class="bg-white relative my-20 mx-auto p-6 rounded-xl w-4/5 max-w-[900px] shadow-2xl border border-gray-200">
    <button id="copyBtn" onclick="copyJson()"
      class="absolute top-4 right-14 text-sm px-4 py-2 cursor-pointer text-white bg-blue-600 hover:bg-blue-700 rounded-lg transition-colors font-medium">Copy</button>
    <button onclick="closeModal()"
      class="absolute top-4 right-4 text-2xl text-gray-600 hover:text-gray-900 w-8 h-8 flex items-center justify-center rounded-lg hover:bg-gray-100 transition-colors">&times;</button>
    <h2 class="text-gray-900 text-xl font-bold mb-4">Raw JSON Output</h2>
    <pre id="jsonContent"
      class="bg-gray-900 text-gray-100 p-4 whitespace-pre-wrap break-words overflow-auto rounded-lg mt-2 border border-gray-700"
      style="max-height:60vh;"></pre>
  </div>
</div>

<script>
  const watchlists = {{ example_watchlists | tojson }};

  // Populate the dropdown with watchlists
  const comp_select = document.getElementById('companies');
  const comp_text = document.getElementById('companies_text');
  watchlists.forEach((watchlist, index) => {
    if (watchlist.id === "{{ companies }}") {
      comp_text.value = watchlist.name;
    }
    const option = document.createElement('option');
    option.value = watchlist.id;
    option.textContent = watchlist.name;
    comp_select.appendChild(option);
  });
  
  // Make watchlists globally available
  window.watchlists = watchlists;

  document.getElementById('showJsonBtn').onclick = function () {
    if (lastReport) {
      document.getElementById('jsonContent').textContent = JSON.stringify(lastReport, null, 2);
      document.getElementById('jsonModal').style.display = 'block';
    }
  };

  window.closeModal = closeModal;
  window.toggleMotivation = toggleMotivation;
  
  
  // Reset to start - clear results and show empty state
  function resetToStart() {
    // Hide dashboard and show empty state
    const emptyState = document.getElementById('emptyState');
    const dashboardSection = document.getElementById('dashboardSection');
    
    if (emptyState) emptyState.style.display = 'block';
    if (dashboardSection) dashboardSection.classList.add('hidden');
    
    // Hide buttons
    const showJsonBtn = document.getElementById('showJsonBtn');
    const newAnalysisBtn = document.getElementById('newAnalysisBtn');
    if (showJsonBtn) showJsonBtn.style.display = 'none';
    if (newAnalysisBtn) newAnalysisBtn.style.display = 'none';
    
    // Clear last report
    window.lastReport = null;
    
    // Reset tabs
    if (window.tabController) {
      window.tabController.reset();
    }
    
    // Scroll to top
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }
  window.resetToStart = resetToStart;

  // Initialize tab controller when DOM is ready
  document.addEventListener('DOMContentLoaded', function() {
    if (window.tabController) {
      window.tabController.init();
    }
  });
</script>
<script src="static/scripts/config_panel.js"></script>
<script src="static/scripts/dashboard_cards.js"></script>
<script src="static/scripts/tab_controller.js"></script>
<script src="static/scripts/heatmap.js"></script>
<script src="static/scripts/company_screener.js?v={{ range(1000, 9999) | random }}"></script>
<script src="static/scripts/mindmap.js?v={{ range(1000, 9999) | random }}"></script>
<script src="static/scripts/evidence_table.js?v={{ range(1000, 9999) | random }}"></script>
<script src="static/scripts/report_renderer.js?v={{ range(1000, 9999) | random }}"></script>
<script src="static/scripts/form.js"></script>

<!-- Version number at bottom of page -->
<div class="text-right pr-4 pb-4">
  <span class="text-xs text-zinc-500">v2.3.2</span>
</div>
{% endblock %}
